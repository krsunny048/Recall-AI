{
  "name": "recall-ai-study-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n API,WEB -c blue,magenta \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/src/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
